{
  "name": "build-report",
  "version": "0.1.0",
  "description": "Zero-dependency node scripts: bundle size analysis report (analysis) + dist cleaner (clean).",
  "type": "module",
  "license": "MIT",
  "main": "./scripts/build-analysis.mjs",
  "exports": {
    "./analysis": "./scripts/build-analysis.mjs",
    "./clean": "./scripts/clean.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "scripts",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mic-zhou/build-report.git"
  },
  "homepage": "https://github.com/mic-zhou/build-report#readme",
  "bugs": {
    "url": "https://github.com/mic-zhou/build-report/issues"
  },
  "keywords": [
    "build",
    "bundle",
    "analysis",
    "report",
    "clean"
  ],
  "engines": {
    "node": ">=16"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^0.34.6",
    "vitest": "^0.34.6"
  }
}
